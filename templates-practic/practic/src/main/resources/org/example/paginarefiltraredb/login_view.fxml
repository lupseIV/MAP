<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20" style="-fx-background-color: blue;"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.paginarefiltraredb.gui.implementations.LoginController">

    <padding>
        <Insets bottom="50" left="50" right="50" top="50" />
    </padding>

    <VBox alignment="CENTER" spacing="15" style="-fx-background-color: white; -fx-background-radius: 10;">
        <padding>
            <Insets bottom="40" left="40" right="40" top="40" />
        </padding>

        <Label text="Dacia" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <Label text="Please login to continue" textFill="#7f8c8d">
            <font>
                <Font size="14.0" />
            </font>
        </Label>

        <VBox spacing="5">
            <Label text="Username" textFill="#2c3e50" />
            <TextField fx:id="usernameField" prefWidth="250" promptText="Enter username" />
        </VBox>

        <VBox spacing="5">
            <Label text="Password" textFill="#2c3e50" />
            <PasswordField fx:id="passwordField" prefWidth="250" promptText="Enter password" />
        </VBox>

        <Label fx:id="errorLabel" textFill="red" visible="false">
            <font>
                <Font size="12.0" />
            </font>
        </Label>

        <Button onAction="#handleLogin" prefWidth="250"
                style="-fx-background-color: blue;
                -fx-text-fill: white;
                 -fx-font-size: 14px;
                 -fx-cursor: hand;"
                text="Login">
        </Button>

    </VBox>
</VBox>
