<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="500" prefWidth="450" spacing="15" style="-fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.paginarefiltraredb.gui.implementations.CarDetailsController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label text="Details" textFill="#2c3e50">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <VBox spacing="5">
        <Label style="-fx-font-weight: bold;" text="Car Name:" textFill="#2c3e50" />
        <TextField fx:id="nameField" editable="false" style="-fx-background-color: #f8f9fa;" />
    </VBox>

    <VBox spacing="5">
        <Label style="-fx-font-weight: bold;" text="Description:" textFill="#2c3e50" />
        <TextArea fx:id="descriptionArea" editable="false" prefRowCount="3" style="-fx-background-color: #f8f9fa;" />
    </VBox>

    <VBox spacing="5">
        <Label style="-fx-font-weight: bold;" text="Base Price:" textFill="#2c3e50" />
        <TextField fx:id="priceField" editable="false" style="-fx-background-color: #f8f9fa;" />
    </VBox>

    <VBox spacing="5">
        <Label style="-fx-font-weight: bold;" text="Current Status:" textFill="#2c3e50" />
        <Label fx:id="statusLabel" style="-fx-padding: 5; -fx-background-radius: 3;">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
    </VBox>

    <VBox fx:id="rejectionReasonBox" managed="false" spacing="5" visible="false">
        <Label style="-fx-font-weight: bold;" text="Rejection Reason:" textFill="#e74c3c" />
        <TextArea fx:id="rejectionReasonArea" editable="false" prefRowCount="2" style="-fx-background-color: #fadbd8;" />
    </VBox>

    <VBox spacing="5">
        <Label style="-fx-font-weight: bold;" text="Comments/Options:" textFill="#2c3e50" />
        <TextArea fx:id="commentsArea" prefRowCount="3" promptText="Enter comments or options for this car..." />
    </VBox>

    <!-- Dealer buttons -->
    <HBox fx:id="dealerButtonsBox" alignment="CENTER_RIGHT" managed="false" spacing="10" visible="false">
        <Button fx:id="submitForApprovalBtn" onAction="#handleSubmitForApproval" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;" text="Submit for Approval" />
        <Button onAction="#handleCancel" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-cursor: hand;" text="Cancel" />
    </HBox>

    <!-- Admin buttons -->
    <HBox fx:id="adminButtonsBox" alignment="CENTER_RIGHT" managed="false" spacing="10" visible="false">
        <Button fx:id="approveBtn" onAction="#handleApprove" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;" text="Approve" />
        <Button fx:id="rejectBtn" onAction="#handleReject" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;" text="Reject" />
        <Button onAction="#handleCancel" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-cursor: hand;" text="Cancel" />
    </HBox>

    <Label fx:id="processingLabel" style="-fx-font-style: italic;" text="Processing... Please wait." textFill="#3498db" visible="false">
        <font>
            <Font size="12.0" />
        </font>
    </Label>

</VBox>
