<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.paginarefiltraredb.gui.implementations.ManagerVipTableViewPagingController"
      spacing="10" style="-fx-padding: 20;">

    <Label text="Manager Task Table" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colName" text="Client Name" prefWidth="150"/>
            <TableColumn fx:id="colLoyalty" text="Loyalty (1-5)" prefWidth="120"/>
            <TableColumn fx:id="colDone" text="Task Done" prefWidth="100"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="buttonPrevious" text="Previous" onAction="#onPrevious"/>
        <Label fx:id="labelPage" text="Page 1 of 1"/>
        <Button fx:id="buttonNext" text="Next" onAction="#onNext"/>
    </HBox>

</VBox>