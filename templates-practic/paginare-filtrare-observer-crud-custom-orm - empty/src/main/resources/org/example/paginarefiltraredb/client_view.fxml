<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.paginarefiltraredb.gui.implementations.DoctorController">



    <center>
        <TableView fx:id="tableView" prefHeight="400" prefWidth="600">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
         <columns>
            <TableColumn fx:id="timeCol" prefWidth="75.0" text="Time" />
            <TableColumn fx:id="numePacientCol" prefWidth="75.0" text="Name" />
            <TableColumn fx:id="cnpPacientCol" prefWidth="75.0" text="CNP" />
            <TableColumn fx:id="actionCol" prefWidth="75.0" text="Finish" />
         </columns>
        </TableView>
    </center>
   <top>
      <CheckBox mnemonicParsing="false" fx:id="checkBoxIstoric"  text="Afiseaza Istoric" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </CheckBox>
   </top>
</BorderPane>
